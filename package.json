{
    "name": "knoux-nexar-pro",
    "version": "3.0.0",
    "description": "Nexar Pro v3.0 - Ultimate Merged Edition by Knoux",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
        "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
        "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
        "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
        "start": "NODE_ENV=production node dist/index.js",
        "check": "tsc --noEmit",
        "lint": "expo lint",
        "format": "prettier --write .",
        "test": "vitest run",
        "db:push": "drizzle-kit generate && drizzle-kit migrate",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "qr": "node scripts/generate_qr.mjs"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.0.3",
        "@paypal/checkout-server-sdk": "^1.0.3",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-community/audio-toolkit": "^2.0.3",
        "@react-native-firebase/app": "^23.8.6",
        "@react-native-firebase/auth": "^23.8.6",
        "@react-native-firebase/firestore": "^23.8.6",
        "@react-native-firebase/storage": "^23.8.6",
        "@react-navigation/bottom-tabs": "^7.8.12",
        "@react-navigation/elements": "^2.9.2",
        "@react-navigation/native": "^7.1.25",
        "@stripe/stripe-react-native": "0.38.5",
        "@tanstack/react-query": "^5.90.12",
        "@trpc/client": "11.7.2",
        "@trpc/react-query": "11.7.2",
        "@trpc/server": "11.7.2",
        "axios": "^1.13.2",
        "clsx": "^2.1.1",
        "cookie": "^1.1.1",
        "dotenv": "^16.6.1",
        "drizzle-orm": "^0.44.7",
        "expo": "^54.0.33",
        "expo-audio": "~1.1.0",
        "expo-av": "~15.0.1",
        "expo-blur": "^15.0.8",
        "expo-build-properties": "^1.0.10",
        "expo-camera": "~16.0.18",
        "expo-clipboard": "~7.0.0",
        "expo-constants": "^17.0.7",
        "expo-file-system": "~18.0.8",
        "expo-font": "^14.0.11",
        "expo-haptics": "~15.0.8",
        "expo-image": "~3.0.11",
        "expo-image-manipulator": "~13.0.5",
        "expo-image-picker": "~16.0.5",
        "expo-keep-awake": "~15.0.8",
        "expo-linear-gradient": "^15.0.8",
        "expo-linking": "^7.0.5",
        "expo-media-library": "~18.0.5",
        "expo-notifications": "~0.32.15",
        "expo-router": "^4.0.17",
        "expo-screen-capture": "^55.0.6",
        "expo-secure-store": "~14.0.0",
        "expo-sensors": "~14.0.2",
        "expo-sharing": "~13.0.1",
        "expo-splash-screen": "~0.29.22",
        "expo-status-bar": "~2.0.1",
        "expo-system-ui": "~4.0.9",
        "expo-task-manager": "~12.0.3",
        "expo-video": "^2.1.2",
        "expo-web-browser": "~14.0.2",
        "hono": "^4.7.7",
        "i18next": "^25.2.1",
        "lottie-react-native": "7.2.2",
        "nativewind": "^4.1.23",
        "react": "18.3.1",
        "react-i18next": "^15.5.2",
        "react-native": "0.76.9",
        "react-native-gesture-handler": "~2.20.2",
        "react-native-reanimated": "~3.16.7",
        "react-native-safe-area-context": "4.12.0",
        "react-native-screens": "~4.4.0",
        "react-native-svg": "15.8.0",
        "react-native-video": "^6.8.5",
        "tailwind-merge": "^3.3.0",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@babel/core": "^7.27.1",
        "@types/react": "~18.3.21",
        "@types/react-native": "^0.73.0",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "drizzle-kit": "^0.31.1",
        "esbuild": "^0.19.0",
        "eslint": "^9.23.0",
        "eslint-config-expo": "~9.2.0",
        "prettier": "^3.5.3",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "vitest": "^3.2.2"
    }
}
