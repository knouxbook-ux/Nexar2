# Copyright © Knoux. All rights reserved.
# ─── Knoux Nexar Pro v3.0 — Environment Variables ────────────────────────────
# انسخ هذا الملف إلى .env وأضف قيمك الخاصة
# FREE: يعمل بدون مفتاح مدفوع | REQUIRED: مطلوب | OPTIONAL: اختياري

# ─── إعداد التطبيق ────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=Nexar Pro
APP_VERSION=3.0.0
APP_DOMAIN=nexarpro.app

# ─── المصادقة ─────────────────────────────────────────────────────────────────
# REQUIRED — يجب أن يكون 32 حرفاً على الأقل
JWT_SECRET=knoux-nexar-pro-ultra-secure-jwt-secret-key-2025

# ─── قاعدة البيانات ────────────────────────────────────────────────────────────
# REQUIRED — MySQL / PlanetScale / Railway
# FREE: planetscale.com أو railway.app
DATABASE_URL=mysql://knoux:password@host:3306/nexar_pro_db

# ─── Firebase ─────────────────────────────────────────────────────────────────
# OPTIONAL — التزامن السحابي (5GB مجاني في Spark Plan)
# الإعداد: https://console.firebase.google.com → مشروع جديد → Nexar Pro
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=nexar-pro.firebaseapp.com
FIREBASE_PROJECT_ID=nexar-pro
FIREBASE_STORAGE_BUCKET=nexar-pro.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Stripe للمدفوعات ─────────────────────────────────────────────────────────
# OPTIONAL — مفاتيح اختبار مجانية من: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# أسعار الاشتراك (أنشئها في Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_999
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_9999
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_monthly_1999
STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly_19999

# ─── PayPal ────────────────────────────────────────────────────────────────────
# OPTIONAL — Sandbox مجاني: https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ─── OpenAI / AI Services ─────────────────────────────────────────────────────
# OPTIONAL — ميزات الذكاء الاصطناعي (GPT-4o, Whisper, DALL-E)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── مفاتيح البث المباشر ──────────────────────────────────────────────────────
# أدخل مفاتيح البث الخاصة بك في واجهة التطبيق مباشرة
# YouTube: studio.youtube.com/channel/*/livestreaming
# Twitch: dashboard.twitch.tv/settings/stream
# TikTok: live.tiktok.com/studio/stream-key

# ─── Vexo Analytics ───────────────────────────────────────────────────────────
# FREE: https://vexo.co — مُهيَّأ بالفعل لـ Knoux
VEXO_API_KEY=37080b48-6799-41ec-9d0c-a5384577f930

# ─── Manus Runtime (مُحقَّن تلقائياً) ───────────────────────────────────────
VITE_APP_ID=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
